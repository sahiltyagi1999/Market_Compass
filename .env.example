PORT=4100
FRONTEND_ORIGIN=http://localhost:5174

# NIFTY data: free Upstox read-only Analytics Token is recommended.
# You can also use the daily OAuth token if you already have that flow.
UPSTOX_ANALYTICS_TOKEN=
# UPSTOX_ACCESS_TOKEN=
UPSTOX_NIFTY_KEY=NSE_INDEX|Nifty 50
UPSTOX_VIX_KEY=NSE_INDEX|India VIX

# Optional: free CoinGecko demo key for more stable crypto requests.
# The app also works against CoinGecko public endpoints without this.
# COINGECKO_DEMO_API_KEY=

# News RSS, Binance candles and crypto Fear & Greed are keyless.
# Optional: GPT adds semantic headline meaning and market-impact explanations.
# The server blends 75% AI sentiment with 25% deterministic sentiment and caches
# unchanged analysis for 15 minutes to control spend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
