PORT=4100
FRONTEND_ORIGIN=http://localhost:5174

# NIFTY data: free Upstox read-only Analytics Token is recommended.
# You can also use the daily OAuth token if you already have that flow.
UPSTOX_ANALYTICS_TOKEN=
# UPSTOX_ACCESS_TOKEN=
UPSTOX_NIFTY_KEY=NSE_INDEX|Nifty 50
UPSTOX_VIX_KEY=NSE_INDEX|India VIX

# Optional: free CoinGecko demo key for more stable crypto requests.
# The app also works against CoinGecko public endpoints without this.
# COINGECKO_DEMO_API_KEY=

# News RSS, Binance candles and crypto Fear & Greed are keyless.
# Optional: GPT adds semantic headline meaning and market-impact explanations.
# AI output is explanation-only: it never changes the directional score.
# Unchanged analysis is cached for 15 minutes to control spend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Prediction history storage. Without DATABASE_URL a local JSON file is used,
# which is NOT durable on hosts with an ephemeral filesystem (Render free).
# DATABASE_URL=postgres://user:password@host/db?sslmode=require
# DATABASE_SSL=require            # require (default) | no-verify | disable
# PREDICTIONS_FILE_DURABLE=false  # set true only if the JSON file sits on a persistent disk

# Outcome thresholds used to label resolved predictions (percent move).
# UP: return > UP_PCT, DOWN: return < -DOWN_PCT, otherwise NEUTRAL.
# NIFTY_OUTCOME_UP_PCT=0.2
# NIFTY_OUTCOME_DOWN_PCT=0.2
# CRYPTO_OUTCOME_UP_PCT=0.2
# CRYPTO_OUTCOME_DOWN_PCT=0.2
